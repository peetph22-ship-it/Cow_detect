# CowCare AI - backend_node (คัดลอกเป็น .env แล้วใส่ค่าจริง ห้าม commit .env)
# วิธีตั้งค่าเครื่องสำหรับคนใหม่: docs/DEV_SETUP.md

# ---- จำเป็น ----
PORT=4001
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-key
# รหัสผ่านฐานข้อมูลจริง: ขอจากเจ้าของโปรเจกต์ทางข้อความส่วนตัว
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# ใช้เซ็น token login: ในเครื่องให้สร้างค่าใหม่ของตัวเอง (openssl rand -hex 32) ห้ามใช้ค่าเดียวกับ Render
SECRET_KEY="your-jwt-secret-key"
# origin ของหน้าเว็บที่อนุญาต (คั่นด้วย ,) localhost:3000 และ 3001 อนุญาตอยู่แล้ว
FRONTEND_URL=http://localhost:3000

# ---- อุปกรณ์ IoT ----
# warn = ยอมรับกล่องที่ไม่มี key แต่ log ไว้ | enforce = ปฏิเสธ 401 (Render ใช้ enforce)
DEVICE_AUTH_MODE=warn

# ---- กล้อง + YOLO (ไม่ต้องตั้งถ้าไม่ได้ทำส่วนกล้อง) ----
# key ฝั่ง server เท่านั้น ใช้ดาวน์โหลดโมเดลจาก bucket models และเก็บภาพตัวอย่างใน camera-samples
# ถ้ามีไฟล์ app/weights/yolo26m_480.onnx ในเครื่องแล้ว ไม่ต้องใช้ key นี้สำหรับโมเดล
SUPABASE_SERVICE_ROLE_KEY=
# กุญแจเข้ารหัสรหัสผ่านกล้อง (AES-256-GCM) 64 ตัวอักษร hex: openssl rand -hex 32
# ในเครื่องใช้ค่าของตัวเองได้ แต่รหัสกล้องที่บันทึกด้วยกุญแจของ Render จะถอดในเครื่องไม่ได้
CAMERA_SECRET_KEY=
YOLO_MODEL_FILE=yolo26m_480.onnx
YOLO_MODEL_BUCKET=models
YOLO_MODEL_PARTS=2
YOLO_MODEL_SHA256=
# 1 = โหลดโมเดลตอนเปิด server (ใช้ RAM ~300MB) ปกติไม่ต้องเปิด ภาพแรกจะโหลดให้เอง
VISION_PRELOAD=0
VISION_TIMEOUT_MS=120000
# ต้องตรงกับ CAMERA_INTERVAL_MIN_VAL ใน firmware ใช้ตัดสินว่ากล้องออฟไลน์
CAMERA_INTERVAL_MIN=10
CAMERA_SAMPLE_BUCKET=camera-samples

# ---- พยากรณ์ ----
# Bi-LSTM (ทดลอง เทรนจากข้อมูลจำลอง) เปิดไว้ false จนกว่าจะเทรนกับข้อมูลจริง
ENABLE_LSTM=false

# ---- LINE (ยังไม่เปิดใช้จริง) ไม่ตั้ง = ระบบแค่ log ข้อความ ไม่ส่งจริง ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# ---- Gemini (ยังไม่มีโค้ดใน backend_node ใช้ค่าเหล่านี้) ----
GEMINI_API_KEY_2=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GENERATE_AMOUNT=100
GEMINI_MAX_RETRIES=5
GEMINI_REQUEST_DELAY_MS=10000
GEMINI_MIN_RETRY_DELAY_MS=5000
GEMINI_MAX_RETRY_DELAY_MS=120000
DB_RETRY_COUNT=3
MAX_DUPLICATE_ATTEMPTS=20
INTERNAL_API_KEY=your-internal-api-key
