PORT=4001
SUPABASE_KEY=your-supabase-key
SUPABASE_URL=https://your-supabase-project.supabase.co
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
SECRET_KEY="your-jwt-secret-key"

# GEMINI KEY
GEMINI_API_KEY_2=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GENERATE_AMOUNT=100
GEMINI_MAX_RETRIES=5
GEMINI_REQUEST_DELAY_MS=10000
GEMINI_MIN_RETRY_DELAY_MS=5000
GEMINI_MAX_RETRY_DELAY_MS=120000
DB_RETRY_COUNT=3
MAX_DUPLICATE_ATTEMPTS=20

INTERNAL_API_KEY=your-internal-api-key
FRONTEND_URL=http://localhost:3000

# IoT Device Auth: warn (log only) | enforce (reject 401)
DEVICE_AUTH_MODE=warn
