// secrets.h ถูก .gitignore ไว้ ห้าม commit
#pragma once

#define WIFI_SSID_VAL      "your-wifi-name"
#define WIFI_PASSWORD_VAL  "your-wifi-password"

// ต้องตรงกับ serial_no ของอุปกรณ์ในหน้า Admin > Devices
#define DEVICE_SERIAL_VAL  "ESP32-S3-01"

// ได้จาก POST /api/Admin/devices/:id/rotate-key (แสดงครั้งเดียว)
#define DEVICE_KEY_VAL     "ccdev_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

// ไม่ต้องมี / ปิดท้าย
#define SERVER_BASE_VAL    "https://cow-detect-zea6.onrender.com/api/sensors"

// ---- กล้อง (ไม่บังคับ) ไม่ใส่บรรทัดเหล่านี้ = ปิดส่วนกล้อง ----
// ESP32 ดึงภาพนิ่งจากกล้องใน LAN ทุก 5 นาที แล้วส่งไป <server>/api/camera/snapshot
#define CAMERA_ENABLED_VAL        0                 // 1 = เปิด
#define CAMERA_HOST_VAL           "192.168.1.108"   // IP กล้องในวงเดียวกับ ESP32
#define CAMERA_PORT_VAL           80
#define CAMERA_USER_VAL           "camera-user"
#define CAMERA_PASS_VAL           "camera-password"
// Dahua: /cgi-bin/snapshot.cgi?channel=1   Hikvision: /ISAPI/Streaming/channels/101/picture
#define CAMERA_SNAPSHOT_PATH_VAL  "/cgi-bin/snapshot.cgi?channel=1"
