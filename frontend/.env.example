# CowCare AI - frontend (คัดลอกเป็น .env) ไม่มีค่าลับ: หน้าเว็บไม่ต้องใช้รหัสฐานข้อมูล
# วิธีตั้งค่าเครื่องสำหรับคนใหม่: docs/DEV_SETUP.md

# backend_node ที่หน้าเว็บจะเรียก
#   ทำแค่หน้าเว็บ: ใช้ API จริง  https://cow-detect-zea6.onrender.com/api
#   รัน backend_node ในเครื่องด้วย: http://localhost:4001/api
NUXT_PUBLIC_NODE_API_BASE=http://localhost:4001/api
# FastAPI (Python) ส่วนเก่า ไม่ได้รันก็ปล่อยไว้ได้
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Supabase แบบ publishable/anon key (เปิดเผยได้ ฝั่ง browser ใช้) ไม่ตั้ง = ใช้ค่าใน nuxt.config.ts
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
