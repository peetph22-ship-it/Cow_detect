# Firmware secrets (Wi-Fi password, device key)
firmware/**/secrets.h

# YOLO model weights (downloaded from Supabase Storage at startup)
backend_node/app/weights/yolo*.onnx
backend_node/app/weights/yolo*.onnx.part*
backend_node/app/weights/*.download

# โมเดล/แคชขนาดใหญ่ (แชร์ผ่าน Drive หรือ Supabase models แทน)
backend/app/weights/*.onnx
**/labels.cache

# prompt/แผนงานสำหรับส่งต่อให้ AI ตัวอื่น (มีรายการงานความปลอดภัยที่ยังค้าง ไม่ขึ้น repo)
docs/prompts/

# ภาพ active learning ที่ระบบเก็บเองจากกล้องจริง (อาจติดคน/ในบ้าน) ไม่ขึ้น repo
# ไฟล์ที่ track ไว้แล้ว (al_simulation_* 82 ไฟล์) ยังอยู่ใน repo ตามเดิม git ไม่สนกฎ ignore กับไฟล์ที่ track แล้ว
backend/app/active_learning_samples/*

# CBVD-5 dataset (Kaggle, CC0): images stay local (3+ GB); tools, camera groups, YOLO labels and split are committed
backend/training_archive/cbvd5/raw/
backend/training_archive/cbvd5/yolo/*/images/
# farm images from collection mode (scripts/download_collected.js): farm data stays local
backend/training_archive/farm_collect/
